--!strict
--!nolint DeprecatedApi

-- Runs game code under Lune (https://lune-org.github.io/docs) the way Roblox would.
--
-- It reads the Rojo sourcemap, so `game:GetService("ReplicatedStorage").Shared.Network`,
-- `script.Parent.Visits` and `require(...)` of those reach the same files Rojo syncs. String
-- requires (./, ../, @self/) resolve next to the requiring file, as in Roblox. Aliases from
-- .luaurc (@pkg/frktest) and Lune's own libraries (@lune/fs) load with Lune's require.
--
-- Instances are stand-ins with Name, ClassName, Parent, FindFirstChild, WaitForChild,
-- GetChildren, GetDescendants, IsA and GetFullName: enough for Hydrogen and plain game code,
-- not a full engine. RunService:IsServer() and IsClient() both return false, so Hydrogen leaves
-- Players and BindToClose alone; use Hydrogen.loopback() for players and a network.
--
-- Generated by create_hydrogen. You can change it; nothing in the game requires it.

local fs = (require :: any)("@lune/fs")
local luau = (require :: any)("@lune/luau")
local process = (require :: any)("@lune/process")
local roblox = (require :: any)("@lune/roblox")
local serde = (require :: any)("@lune/serde")
local lunetask = (require :: any)("@lune/task")

local nativeRequire = require :: any

local Roblox = {}

type Node = {
	Name: string,
	ClassName: string,
	Parent: Node?,
}

local projectRoot = string.gsub(string.gsub(process.cwd :: string, "\\", "/"), "/+$", "")
local nodeMeta: { [string]: any } = {}
local nodeByFile: { [string]: Node } = {}
-- Kept beside the nodes, not in them, so a child named "children" still works.
local childrenOf: { [Node]: { Node } } = {}
local fileOf: { [Node]: string } = {}
local cache: { [string]: { done: boolean, value: any } } = {}
local globals: { [string]: any } = {}
local dataModel: Node

-- Roblox datatypes that @lune/roblox provides, made global like in Roblox.
local DATATYPES = {
	"Axes",
	"BrickColor",
	"CFrame",
	"Color3",
	"ColorSequence",
	"ColorSequenceKeypoint",
	"Enum",
	"Faces",
	"Font",
	"NumberRange",
	"NumberSequence",
	"NumberSequenceKeypoint",
	"Ray",
	"Rect",
	"Region3",
	"UDim",
	"UDim2",
	"Vector2",
	"Vector3",
}

local INHERITS: { [string]: { string } } = {
	ModuleScript = { "LuaSourceContainer" },
	Script = { "BaseScript", "LuaSourceContainer" },
	LocalScript = { "Script", "BaseScript", "LuaSourceContainer" },
}

---------------------------------------------------------------------------------------------
-- Paths

local function normalize(path: string): string
	path = string.gsub(path, "\\", "/")
	if not (string.match(path, "^%a:/") or string.sub(path, 1, 1) == "/") then
		path = `{projectRoot}/{path}`
	end
	local parts = {}
	for part in string.gmatch(path, "[^/]+") do
		if part == ".." then
			table.remove(parts)
		elseif part ~= "." then
			table.insert(parts, part)
		end
	end
	local joined = table.concat(parts, "/")
	return if string.sub(path, 1, 1) == "/" then "/" .. joined else joined
end

local function dirname(path: string): string
	return string.match(path, "^(.*)/[^/]+$") or path
end

local function isInit(file: string): boolean
	return string.match(file, "/init%.luau?$") ~= nil
end

local function findModuleFile(base: string): string?
	for _, candidate in { base .. ".luau", base .. ".lua", base .. "/init.luau", base .. "/init.lua" } do
		if fs.isFile(candidate) then
			return candidate
		end
	end
	return nil
end

---------------------------------------------------------------------------------------------
-- Instance stand-ins

local function newNode(name: string, className: string, parent: Node?): Node
	local node = setmetatable({ Name = name, ClassName = className, Parent = parent }, nodeMeta) :: any
	childrenOf[node] = {}
	if parent then
		table.insert(childrenOf[parent], node)
	end
	return node
end

local methods = {}

function methods.FindFirstChild(self: Node, name: string): Node?
	for _, child in childrenOf[self] do
		if child.Name == name then
			return child
		end
	end
	return nil
end

function methods.WaitForChild(self: Node, name: string): Node
	local child = methods.FindFirstChild(self, name)
	if not child then
		-- Everything is "replicated" up front here, so waiting would hang forever.
		error(`{methods.GetFullName(self)} has no child named {name} (WaitForChild in Lune doesn't wait)`, 2)
	end
	return child
end

function methods.GetChildren(self: Node): { Node }
	return table.clone(childrenOf[self])
end

function methods.GetDescendants(self: Node): { Node }
	local all = {}
	local function walk(node: Node)
		for _, child in childrenOf[node] do
			table.insert(all, child)
			walk(child)
		end
	end
	walk(self)
	return all
end

function methods.IsA(self: Node, className: string): boolean
	if className == self.ClassName or className == "Instance" then
		return true
	end
	return table.find(INHERITS[self.ClassName] or {}, className) ~= nil
end

function methods.GetFullName(self: Node): string
	local names = {}
	local node: Node? = self
	while node and node ~= dataModel do
		table.insert(names, 1, node.Name)
		node = node.Parent
	end
	return table.concat(names, ".")
end

function methods.GetService(self: Node, name: string): any
	local service = methods.FindFirstChild(self, name)
	if not service then
		service = newNode(name, name, self)
	end
	return service
end

function methods.BindToClose(_self: Node, _callback: () -> ()) end

nodeMeta.__index = function(self: Node, key: string): any
	local method = methods[key]
	if method then
		return method
	end
	local child = methods.FindFirstChild(self, key)
	if child then
		return child
	end
	error(`{key} is not a valid member of {self.ClassName} "{methods.GetFullName(self)}"`, 2)
end
nodeMeta.__tostring = function(self: Node): string
	return self.Name
end

local function signal()
	return {
		Connect = function()
			return { Connected = true, Disconnect = function() end }
		end,
		Once = function()
			return { Connected = true, Disconnect = function() end }
		end,
		Wait = function()
			error("can't wait on an engine event in Lune", 2)
		end,
	}
end

-- Services whose methods game code (and Hydrogen) calls at require time.
local function addServiceStubs()
	local runService = methods.GetService(dataModel, "RunService") :: any
	rawset(runService, "IsServer", function()
		return false
	end)
	rawset(runService, "IsClient", function()
		return false
	end)
	rawset(runService, "IsStudio", function()
		return false
	end)
	for _, event in { "Heartbeat", "Stepped", "RenderStepped", "PreSimulation", "PostSimulation" } do
		rawset(runService, event, signal())
	end

	local players = methods.GetService(dataModel, "Players") :: any
	rawset(players, "GetPlayers", function()
		return {}
	end)
	rawset(players, "PlayerAdded", signal())
	rawset(players, "PlayerRemoving", signal())
end

---------------------------------------------------------------------------------------------
-- Sourcemap

local function readSourcemap(projectFile: string): any
	local ok, result = pcall(process.exec, "rojo", { "sourcemap", projectFile })
	if not ok then
		error("couldn't run `rojo sourcemap`: is Rojo installed? Run `rokit install`.\n" .. tostring(result), 0)
	end
	if not result.ok then
		error(`rojo sourcemap {projectFile} failed:\n{result.stderr}`, 0)
	end
	return serde.decode("json", result.stdout)
end

local function build(entry: any, parent: Node?): Node
	local node = newNode(entry.name, entry.className, parent)
	for _, path in entry.filePaths or {} do
		if string.match(path, "%.luau?$") then
			local file = normalize(path)
			fileOf[node] = file
			nodeByFile[file] = node
			break
		end
	end
	for _, child in entry.children or {} do
		build(child, node)
	end
	return node
end

---------------------------------------------------------------------------------------------
-- require

local load: (file: string, node: Node?) -> any

local function requireString(path: string, file: string): any
	if string.sub(path, 1, 1) == "@" and string.sub(path, 1, 6) ~= "@self/" then
		return nativeRequire(path)
	end

	local base
	if string.sub(path, 1, 6) == "@self/" then
		base = if isInit(file) then dirname(file) else (string.gsub(file, "%.luau?$", ""))
		path = string.sub(path, 7)
	elseif string.sub(path, 1, 2) == "./" or string.sub(path, 1, 3) == "../" then
		-- An init file stands for its folder, so its ./ is the folder's parent.
		base = if isInit(file) then dirname(dirname(file)) else dirname(file)
	else
		error(`require("{path}"): string requires must start with ./, ../ or @`, 3)
	end

	local target = findModuleFile(normalize(`{base}/{path}`))
	if not target then
		error(`require("{path}") from {file}: no module at {normalize(`{base}/{path}`)}`, 3)
	end
	return load(target, nodeByFile[target])
end

local function makeRequire(file: string)
	return function(target: any): any
		if type(target) == "string" then
			return requireString(target, file)
		end
		if getmetatable(target) == nodeMeta then
			local node = target :: Node
			local moduleFile = fileOf[node]
			if node.ClassName ~= "ModuleScript" or not moduleFile then
				error(`require: {methods.GetFullName(node)} isn't a ModuleScript`, 2)
			end
			return load(moduleFile, node)
		end
		error(`require: expected a ModuleScript or a path, got {typeof(target)}`, 2)
	end
end

load = function(file: string, node: Node?): any
	local cached = cache[file]
	if cached then
		if not cached.done then
			error(`cyclic require of {file}`, 3)
		end
		return cached.value
	end
	local entry = { done = false, value = nil :: any }
	cache[file] = entry

	local env = setmetatable({ script = node, require = makeRequire(file) }, { __index = globals })
	local name = if node then methods.GetFullName(node) else file
	local chunk = luau.load(fs.readFile(file), { debugName = "@" .. name, environment = env, injectGlobals = false })
	entry.value = chunk()
	entry.done = true
	return entry.value
end

---------------------------------------------------------------------------------------------

-- @lune/roblox's CFrame.lookAt (Lune 0.10) faces the wrong way for any target with a Z
-- component, and returns NaN looking straight up or down. This one matches Roblox.
local function lookAt(cframe: any, vector3: any): (any, any, any?) -> any
	return function(at: any, target: any, up: any?): any
		local look = target - at
		if look.Magnitude < 1e-9 then
			return cframe.new(at)
		end
		look = look.Unit
		local right = look:Cross(up or vector3.new(0, 1, 0))
		if right.Magnitude < 1e-6 then
			right = vector3.new(1, 0, 0)
		end
		right = right.Unit
		return cframe.fromMatrix(at, right, right:Cross(look), -look)
	end
end

-- Builds the DataModel from the sourcemap and sets up the Roblox globals. Call once.
function Roblox.install(projectFile: string?)
	dataModel = build(readSourcemap(projectFile or "default.project.json"), nil)
	dataModel.Name = "Game"
	addServiceStubs()

	-- Lune's builtins (print, utf8, buffer, ...) are only reachable through the script's
	-- environment: they aren't in _G and can't be iterated.
	setmetatable(globals, { __index = getfenv(0) })
	for _, name in DATATYPES do
		globals[name] = roblox[name]
	end
	globals.CFrame = setmetatable({ lookAt = lookAt(roblox.CFrame, roblox.Vector3) }, { __index = roblox.CFrame })
	globals.Instance = roblox.Instance
	globals.game = dataModel
	globals.workspace = methods.GetService(dataModel, "Workspace")
	globals.task = lunetask
	globals.shared = {}
end

-- Loads a file (a path from the project root) with the Roblox globals, e.g. a test file.
function Roblox.require(path: string): any
	local file = findModuleFile((string.gsub(normalize(path), "%.luau?$", ""))) or normalize(path)
	return load(file, nodeByFile[file])
end

return Roblox
